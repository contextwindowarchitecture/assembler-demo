{
  "$comment": "The adapter command for each assembler, relative to this directory. Each takes a snapshot's bytes on stdin and answers by exit code: 0 assembled or refused ({\"payload\": base64 | null, \"trace\": {...}} on stdout), 2 rejected before assembly, 3 tokenizer or renderer not provided. Set the environment variable named in `env` to a whole command line to override one.",
  "python": {
    "language": "Python",
    "name": "cwa-assembler",
    "checkout": "../assembler-python",
    "command": ["uv", "run", "--quiet", "--project", "../assembler-python", "python", "adapters/python_adapter.py"],
    "requires": ["../assembler-python/pyproject.toml"],
    "env": "CWA_PYTHON_ADAPTER"
  },
  "typescript": {
    "language": "TypeScript",
    "name": "@contextwindowarchitecture/assembler",
    "checkout": "../assembler-typescript",
    "command": ["node", "adapters/typescript_adapter.mjs"],
    "requires": ["node_modules/@contextwindowarchitecture/assembler/dist/index.js"],
    "env": "CWA_TYPESCRIPT_ADAPTER"
  },
  "go": {
    "language": "Go",
    "name": "github.com/contextwindowarchitecture/assembler-go",
    "checkout": "../assembler-go",
    "command": ["bin/cwa-adapter-go"],
    "requires": ["bin/cwa-adapter-go"],
    "env": "CWA_GO_ADAPTER"
  },
  "rust": {
    "language": "Rust",
    "name": "contextwindowarchitecture-assembler",
    "checkout": "../assembler-rust",
    "command": ["bin/cwa-adapter-rust"],
    "requires": ["bin/cwa-adapter-rust"],
    "env": "CWA_RUST_ADAPTER"
  }
}
