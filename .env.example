# Copy to .env (gitignored). The inspector loads it at startup; variables already in the environment win.

# Local model through an OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, llama.cpp, ...).
CWA_DEMO_LOCAL_BASE_URL=http://localhost:11434/v1
# CWA_DEMO_LOCAL_MODEL=llama3.1          # default: the first model the server lists at /v1/models
# CWA_DEMO_LOCAL_API_KEY=                # only if the server checks one
# CWA_DEMO_LOCAL_REASONING_EFFORT=low    # low | medium | high: a reasoning model (gpt-oss, Qwen3) otherwise spends the reserved output thinking

# Anthropic Messages API, or an Anthropic-compatible local server (set ANTHROPIC_BASE_URL; a key placeholder is used
# when none is given; the beta refusal fallbacks and adaptive thinking are off for a custom base URL unless forced).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=http://127.0.0.1:8000
# CWA_DEMO_ANTHROPIC_MODEL=claude-opus-5
# CWA_DEMO_ANTHROPIC_FALLBACKS=off       # on | off
# CWA_DEMO_ANTHROPIC_THINKING=adaptive   # adaptive | off

# OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# CWA_DEMO_OPENAI_MODEL=gpt-5
# CWA_DEMO_OPENAI_REASONING_EFFORT=low

# CWA_DEMO_PROVIDERS=off                 # disable every provider
