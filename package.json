{
  "name": "cwa-demo-app",
  "version": "0.1.0",
  "private": true,
  "description": "Support-assistant demo for the Context Window Architecture: frozen scenarios, a three-assembler comparison harness, and an inspector for candidates, decisions and the outbound request",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cwa-demo": "src/harness/cli.mjs"
  },
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "test": "node --test test/*.test.mjs",
    "vendor": "python3 scripts/vendor_contract.py --website",
    "vendor:verify": "python3 scripts/vendor_contract.py --verify",
    "scenarios:build": "node scripts/build-scenarios.mjs && npm run producers:write",
    "scenarios:check": "node scripts/build-scenarios.mjs --check && npm run producers:check",
    "producers:write": "uv run --quiet --directory producers python -m producers.freeze --write",
    "producers:check": "uv run --quiet --directory producers python -m producers.freeze --check",
    "expect": "node src/harness/cli.mjs expect",
    "compare": "node src/harness/cli.mjs compare",
    "conformance": "node src/harness/cli.mjs conformance",
    "live": "node src/harness/cli.mjs answer scenarios/basic/03-authority/snapshot.messages.json --provider all",
    "test:live": "CWA_DEMO_LIVE=1 node --test test/live.test.mjs",
    "inspector": "node src/inspector/server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@contextwindowarchitecture/assembler": "file:../cwa-assembler-ts",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openai": "7.23.0"
  }
}
